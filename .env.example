# Copy this file to .env and fill in your real values. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-api03-xxxx
DATABRICKS_HOST=community.cloud.databricks.com
DATABRICKS_TOKEN=dapi-xxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxx

# LangSmith tracing — get the API key from your account's Settings page.
# Endpoint depends on which regional deployment you signed up on (check the
# URL you log in with, e.g. apac.smith.langchain.com -> apac.api.smith.langchain.com;
# the global default is https://api.smith.langchain.com).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxx
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=capstone2-multi-agent-assistant
